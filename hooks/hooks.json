{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/harvest-workflow.cjs\"",
            "timeout": 10,
            "statusMessage": "固化 Ultracode 运行记录..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-pointer.cjs\"",
            "timeout": 5,
            "statusMessage": "检查本机 workflow 模板..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-intake.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
